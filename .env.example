# AWS Configuration
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# Amazon Bedrock Settings
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_KB_ID=your-bedrock-knowledge-base-id

# DynamoDB Tables
DYNAMODB_TICKETS_TABLE=GoDispatch_Tickets
DYNAMODB_CLIENTS_TABLE=GoDispatch_Clients

# Notifications & Alerts
SNS_DISPATCH_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:GoDispatch_CriticalAlerts
DISPATCH_PHONE_NUMBER=+14703266811

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False